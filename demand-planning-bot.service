[Unit]
Description=Demand Planning MCP Server
After=network.target
Documentation=https://github.com/CohereJohnny/demand-planning-bot

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/demand-planning-bot
Environment="PATH=/opt/demand-planning-bot/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/opt/demand-planning-bot/.env

# Main server command - HTTP transport for production
ExecStart=/opt/demand-planning-bot/.venv/bin/python /opt/demand-planning-bot/server.py --transport http --port 8000

# Restart policy
Restart=always
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=300

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/demand-planning-bot/logs

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=demand-planning-bot

[Install]
WantedBy=multi-user.target

