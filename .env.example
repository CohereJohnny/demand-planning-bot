# Demand Planning MCP Server Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# API Keys (Optional for Sprint 1, required for full functionality)
# =============================================================================

# EIA API Key - For real oil price data (Brent crude, WTI)
# Get your free API key at: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# News API Key - For geopolitical news and risk assessment
# Get your free API key at: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# =============================================================================
# Server Configuration
# =============================================================================

# Server Secret - For authentication with North platform (optional for local testing)
# Leave empty for local stdio testing
SERVER_SECRET=

# Server Port - Port for HTTP transport (default: 5222)
PORT=5222

# Debug Mode - Enable verbose logging (default: false)
# Set to "true", "1", or "yes" to enable
DEBUG=false

